{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom", "geojson"],

    /* Emit — Vite handles transpilation */
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,

    /* Strictness — non-negotiable for this codebase */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    /* Interop */
    "esModuleInterop": true,
    "skipLibCheck": true,

    /* Paths — resolved relative to this file; `baseUrl` is deprecated in TS 6. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  /* Node-environment tests are checked by tsconfig.test.json, which has the
     Node types they need. */
  "exclude": ["src/**/*.node.test.ts"]
}

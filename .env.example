# -----------------------------------------------------------------------------
# Copy to `.env.local` and fill in with values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# Only VITE_-prefixed variables are exposed to the browser bundle. Everything in
# this file is therefore PUBLIC by definition — never put a secret here.
# -----------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=

# The anon / publishable key. This key is safe to ship to browsers: it carries no
# privileges of its own and every request it makes is subject to Row Level Security.
#
# NEVER put the service_role (or sb_secret_...) key here. It bypasses RLS entirely
# and would hand every tenant's data to anyone who opens developer tools. The app
# inspects this value at startup and refuses to run if a privileged key is detected.
VITE_SUPABASE_ANON_KEY=

# Optional. Shown in the browser tab and the application shell.
VITE_APP_NAME=Atlas

# Optional. The fleet map's basemap, as a MapLibre style document URL.
#
# Map tiles are a metered commercial service. This product ships no tile endpoint
# of its own and borrows nobody else's: point this at a style you are licensed to
# use (your own MapTiler / Stadia / Protomaps key, or a self-hosted style) and set
# the attribution that licence requires. Left blank, the fleet map still plots
# every vehicle — it just draws no basemap underneath and says so.
VITE_MAP_STYLE_URL=

# Attribution text shown on the map. Required by most tile licences.
VITE_MAP_ATTRIBUTION=

# Optional. Replaces the Stripe setup guide the Billing page links to.
#
# Public by design: a documentation address, not a credential. Leave it unset and
# Billing links to the canonical guide for this project —
# https://profitstudio.app/video/add-stripe-subscriptions-supabase — so the button
# is never missing. Set it only if you are distributing your own build with your
# own tutorial. Must be https; anything else is ignored in favour of the default.
VITE_STRIPE_GUIDE_URL=

# -----------------------------------------------------------------------------
# SaaS subscription billing (Stripe)
#
# NONE OF THESE BELONG HERE. They are listed for documentation only: every one is
# a SERVER secret and must be set as a Supabase Edge Function secret, never as a
# VITE_ variable. Anything prefixed VITE_ is compiled into the browser bundle and
# is public by definition — a Stripe secret key there would let anyone charge,
# refund and read every customer in the account.
#
#   supabase secrets set BILLING_STRIPE_SECRET_KEY=sk_live_...
#   supabase secrets set BILLING_STRIPE_WEBHOOK_SECRET=whsec_...
#   supabase secrets set BILLING_APP_URL=https://your-app.example
#   supabase secrets set BILLING_PLAN_CATALOGUE='[{"plan_key":"standard","price_id":"price_..."}]'
#
# BILLING_STRIPE_SECRET_KEY    Stripe secret key. Its prefix decides the mode:
#                              sk_test_/rk_test_ for a sandbox, sk_live_/rk_live_
#                              for the real account. The server refuses to start a
#                              checkout if a configured price belongs to the other
#                              mode.
# BILLING_STRIPE_WEBHOOK_SECRET  The signing secret for the billing-webhook
#                              endpoint. Without it the webhook refuses every
#                              request — there is deliberately no development
#                              fallback that trusts unsigned JSON.
# BILLING_APP_URL              The trusted origin Checkout and the Customer
#                              Portal return to. Never taken from a request
#                              header or a redirect parameter.
# BILLING_PLAN_CATALOGUE       A JSON array of the plans this deployment sells:
#                              [{"plan_key":"standard","price_id":"price_..."}] or
#                              [{"plan_key":"standard","lookup_key":"standard"}].
#                              Prices, currencies and intervals are read FROM
#                              Stripe — this only says which are sellable, so a
#                              plan cannot claim one amount here and charge
#                              another there.
#
# With none of these set, the product runs exactly as it does today: Billing
# reports that subscription billing is not configured, no enforcement applies, and
# every other module is unaffected.
